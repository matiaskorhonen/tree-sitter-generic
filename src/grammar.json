{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "generic",
  "word": "_word",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "line_comment"
          },
          {
            "type": "SYMBOL",
            "name": "block_comment"
          },
          {
            "type": "SYMBOL",
            "name": "html_comment"
          },
          {
            "type": "SYMBOL",
            "name": "hash_comment"
          },
          {
            "type": "SYMBOL",
            "name": "triple_quoted_string"
          },
          {
            "type": "SYMBOL",
            "name": "json_label"
          },
          {
            "type": "SYMBOL",
            "name": "quoted_string"
          },
          {
            "type": "SYMBOL",
            "name": "date"
          },
          {
            "type": "SYMBOL",
            "name": "hash"
          },
          {
            "type": "SYMBOL",
            "name": "number"
          },
          {
            "type": "SYMBOL",
            "name": "tag"
          },
          {
            "type": "SYMBOL",
            "name": "attribute"
          },
          {
            "type": "SYMBOL",
            "name": "keyword"
          },
          {
            "type": "SYMBOL",
            "name": "_word"
          },
          {
            "type": "SYMBOL",
            "name": "_other"
          }
        ]
      }
    },
    "_word": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[a-zA-Z_]\\w*"
      }
    },
    "hash_comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": ".*"
          }
        ]
      }
    },
    "json_label": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\"\\\\\\r\\n]"
                },
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "STRING",
                      "value": "\\"
                    },
                    {
                      "type": "PATTERN",
                      "value": "[^\\r\\n]"
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "PATTERN",
            "value": "[ \\t]*"
          },
          {
            "type": "STRING",
            "value": ":"
          }
        ]
      }
    },
    "quoted_string": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "\""
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "PATTERN",
                      "value": "[^\"\\\\\\r\\n]"
                    },
                    {
                      "type": "SEQ",
                      "members": [
                        {
                          "type": "STRING",
                          "value": "\\"
                        },
                        {
                          "type": "PATTERN",
                          "value": "[^\\r\\n]"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "type": "STRING",
                "value": "\""
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "'"
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "PATTERN",
                      "value": "[^'\\\\\\r\\n]"
                    },
                    {
                      "type": "SEQ",
                      "members": [
                        {
                          "type": "STRING",
                          "value": "\\"
                        },
                        {
                          "type": "PATTERN",
                          "value": "[^\\r\\n]"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "type": "STRING",
                "value": "'"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "`"
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "PATTERN",
                      "value": "[^`\\\\\\r\\n]"
                    },
                    {
                      "type": "SEQ",
                      "members": [
                        {
                          "type": "STRING",
                          "value": "\\"
                        },
                        {
                          "type": "PATTERN",
                          "value": "[^\\r\\n]"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "type": "STRING",
                "value": "`"
              }
            ]
          }
        ]
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "0[xX][0-9a-fA-F][0-9a-fA-F_]*"
          },
          {
            "type": "PATTERN",
            "value": "[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?"
          },
          {
            "type": "PATTERN",
            "value": "\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?"
          }
        ]
      }
    },
    "date": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:?[0-9]{2})"
          },
          {
            "type": "PATTERN",
            "value": "[A-Z][a-z]{2},\\s+[0-9]{1,2}\\s+[A-Z][a-z]{2}\\s+[0-9]{4}\\s+[0-9]{2}:[0-9]{2}:[0-9]{2}\\s+[A-Z]{2,4}"
          }
        ]
      }
    },
    "hash": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "[a-fA-F0-9]{128}"
            },
            {
              "type": "PATTERN",
              "value": "[a-fA-F0-9]{96}"
            },
            {
              "type": "PATTERN",
              "value": "[a-fA-F0-9]{64}"
            },
            {
              "type": "PATTERN",
              "value": "[a-fA-F0-9]{56}"
            },
            {
              "type": "PATTERN",
              "value": "[a-fA-F0-9]{40}"
            },
            {
              "type": "PATTERN",
              "value": "[a-fA-F0-9]{32}"
            }
          ]
        }
      }
    },
    "tag": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "<"
              },
              {
                "type": "PATTERN",
                "value": "[a-zA-Z][a-zA-Z0-9-]*"
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "PATTERN",
                  "value": "\\s+[a-zA-Z_][a-zA-Z0-9_-]*\\s*=\\s*\"[^\"]*\""
                }
              },
              {
                "type": "PATTERN",
                "value": "\\s*"
              },
              {
                "type": "STRING",
                "value": "/>"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "<"
              },
              {
                "type": "PATTERN",
                "value": "[a-zA-Z][a-zA-Z0-9-]*"
              },
              {
                "type": "REPEAT",
                "content": {
                  "type": "PATTERN",
                  "value": "\\s+[a-zA-Z_][a-zA-Z0-9_-]*\\s*=\\s*\"[^\"]*\""
                }
              },
              {
                "type": "PATTERN",
                "value": "\\s*"
              },
              {
                "type": "STRING",
                "value": ">"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "</"
              },
              {
                "type": "PATTERN",
                "value": "[a-zA-Z][a-zA-Z0-9-]*"
              },
              {
                "type": "PATTERN",
                "value": "\\s*"
              },
              {
                "type": "STRING",
                "value": ">"
              }
            ]
          }
        ]
      }
    },
    "attribute": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "(?:[vV][aA][rR]|[vV][aA][lL]|[lL][eE][tT]|[iI][fF]|[eE][lL][sS][eE]|[eE][xX][pP][oO][rR][tT]|[iI][mM][pP][oO][rR][tT]|[rR][eE][tT][uU][rR][nN]|[sS][tT][aA][tT][iI][cC]|[fF][uU][nN]|[fF][uU][nN][cC][tT][iI][oO][nN]|[fF][uU][nN][cC]|[cC][lL][aA][sS][sS]|[oO][pP][eE][nN]|[nN][eE][wW]|[aA][sS]|[wW][hH][eE][rR][eE]|[sS][eE][lL][eE][cC][tT]|[dD][eE][lL][eE][tT][eE]|[aA][dD][dD]|[lL][iI][mM][iI][tT]|[uU][pP][dD][aA][tT][eE]|[iI][nN][sS][eE][rR][tT])"
        }
      }
    },
    "keyword": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "(?:[tT][rR][uU][eE]|[fF][aA][lL][sS][eE]|[tT][oO]|[sS][tT][rR][iI][nN][gG]|[iI][nN][tT]|[fF][lL][oO][aA][tT]|[dD][oO][uU][bB][lL][eE]|[bB][oO][oO][lL]|[bB][oO][oO][lL][eE][aA][nN]|[fF][rR][oO][mM])"
        }
      }
    },
    "_other": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\s]"
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "line_comment"
    },
    {
      "type": "SYMBOL",
      "name": "block_comment"
    },
    {
      "type": "SYMBOL",
      "name": "html_comment"
    },
    {
      "type": "SYMBOL",
      "name": "triple_quoted_string"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}